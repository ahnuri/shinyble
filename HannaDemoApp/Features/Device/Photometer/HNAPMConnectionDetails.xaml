<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HannaDemoApp.Features.Photometer.HNAPMConnectionDetails"
    Title="Photometer Details">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label 
                Text="{Binding DeviceDisplayName}" 
                FontSize="20"
                FontAttributes="Bold"/>

            <Label 
                Text="{Binding DeviceSubtitle}" 
                FontSize="14"
                TextColor="Gray"/>

            <ActivityIndicator
                IsRunning="{Binding IsLoadingDeviceInfo}"
                IsVisible="{Binding IsLoadingDeviceInfo}"
                HorizontalOptions="Start"/>

            <VerticalStackLayout Spacing="8">
                <Label Text="Device Info"
                       FontSize="16"
                       FontAttributes="Bold"/>

                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="8">
                    <Label Text="Model"/>
                    <Label Grid.Column="1"
                           Text="{Binding Device.DeviceInfo.MeterModel}"/>

                    <Label Grid.Row="1"
                           Text="Meter ID"/>
                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Device.DeviceInfo.MeterId}"/>

                    <Label Grid.Row="2"
                           Text="Meter FW"/>
                    <Label Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding Device.DeviceInfo.MeterFirmwareVersion}"/>

                    <Label Grid.Row="3"
                           Text="Serial"/>
                    <Label Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding Device.DeviceInfo.SerialNumber}"/>

                    <Label Grid.Row="4"
                           Text="Raw"/>
                    <Label Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding Device.DeviceInfo.RawDeviceInfo}"
                           LineBreakMode="WordWrap"/>
                </Grid>
            </VerticalStackLayout>

            <Button Text="Update Device Firmware"
                    Command="{Binding UpdateDeviceFirmwareCommand}"
                    IsEnabled="{Binding CanTapFirmwareButton}"/>

        </VerticalStackLayout>
    </ScrollView>

        <!-- OTA progress overlay (similar to native HUD) -->
        <Grid IsVisible="{Binding IsOtaInProgress}"
              BackgroundColor="#99000000"
              Padding="24">
            <Border Stroke="#33000000"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFFFF, Dark=#FF2C2C2E}"
                    Padding="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="340">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Firmware update"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding OtaProgressTitle}"
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center"/>
                    <ProgressBar Progress="{Binding OtaProgress}"
                                 HeightRequest="6"
                                 Margin="0,4,0,0"/>
                    <ActivityIndicator IsRunning="{Binding IsOtaInProgress}"
                                       HeightRequest="32"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
